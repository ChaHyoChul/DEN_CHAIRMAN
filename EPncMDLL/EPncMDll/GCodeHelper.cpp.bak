BOOL pa::CGCodeHelper::CheckM140_M147_ToolChange( char* pNCCode, int* pErrorToolNo, int *pnToolNo )
{
	static char* STR_NC_COMMAND[] = {
		"M140", "M141", "M142", "M143", "M144", "M145", "M146", "M147",
		"m140", "m141", "m142", "m143", "m144", "m145", "m146", "m147" 
	};

	//////////////////////////////////////////////////////////////////////////
	// 툴 사용시간 기능이나 연관툴 기능을 사용하지 않으면 리턴 
// 	if( !( PTool->GetEnableToolUsageTime() || PTool->GetEnableRelatedTool() ) ) {
// 		return TRUE;
// 	}

	//////////////////////////////////////////////////////////////////////////
	// 명령에 툴 체인지 명령이 있는지 확인 
	BOOL	bFind = FALSE;
	int		toolNo = 0;
	char*	pToolChangeCmd = NULL;
	for( toolNo = 0; toolNo<16; toolNo++ ) {
		pToolChangeCmd = strstr( pNCCode, STR_NC_COMMAND[toolNo] );
		if( pToolChangeCmd ) {
			bFind = TRUE;
			break;
		}
	}
	if( bFind == FALSE ) {
		// 없으면 리턴 
		return TRUE;
	}

	//////////////////////////////////////////////////////////////////////////
	// Tool 번호를 다시 계산 한다
	toolNo %= 8;
	toolNo += 1;
	if( pnToolNo ) {
		*pnToolNo = toolNo;
	}

	//////////////////////////////////////////////////////////////////////////
	// 툴 사용시간 기능이나 연관툴 기능을 사용하지 않으면 리턴 
	if( !( PTool->GetEnableToolUsageTime() || PTool->GetEnableRelatedTool() ) ) {
		return TRUE;
	}

	//////////////////////////////////////////////////////////////////////////
	// 사용시간 에러 확인 
	BOOL fOverUsingRate = FALSE;
	if( PTool->GetEnableToolUsageTime() ) {
		double fToolUsingRate = PTool->GetToolData(toolNo)->fUsingRate;
		double fMaxUsingRate = 99.0;
		if( fToolUsingRate > fMaxUsingRate ) {
			fOverUsingRate = TRUE;
		}
	}
	//////////////////////////////////////////////////////////////////////////
	
	//////////////////////////////////////////////////////////////////////////
	// 툴 에러일 경우, 연관툴 확인 
	DWORD	dwToolErrorCode = PTool->GetToolData(toolNo)->dwErrCode;
	int		nReplaceToolNo = 0;
	if( fOverUsingRate == TRUE || dwToolErrorCode != 0 ) {
		if( PTool->GetEnableRelatedTool() == TRUE ) {
			// 연관툴 사용. 다음 사용할 툴을 찾는다 
			nReplaceToolNo = PTool->GetNextRelatedToolNo( toolNo );
			if( nReplaceToolNo != 0 ) {
				// 명령을 변경 한다 
				memcpy( (void*)pToolChangeCmd, (const void*)STR_NC_COMMAND[nReplaceToolNo-1], strlen(STR_NC_COMMAND[nReplaceToolNo-1]) );
			} else {
				// 연관 툴에서도 사용할 툴이 없다 
				*pErrorToolNo = toolNo;
				return FALSE;
			}
		}
		else {
			// 연관툴을 사용하지 않음. 
			*pErrorToolNo = toolNo;
			return FALSE;
		}
	}
	//////////////////////////////////////////////////////////////////////////

	return TRUE;
}

// nToolNo 번호는 1번부터 시작. 리턴하는 tool 번호도 1부터 시작하는 번호 
// 만약 리턴이 0이면 사용할 수 있는 툴이 없는것 임 
/*
int pmac::CGCodeHelper::CheckM140_M145_Restart(int nToolNo )
{
	double	fTempToolUasgeRate	= Pmac::PTools->GetToolData( nToolNo ).fUsageRate;
	double	fTempMaxUsafeRete	= Pmac::PTools->GetMaxToolUsageRate();
	int		nReplaceToolNo = nToolNo;

	if( fTempToolUasgeRate > fTempMaxUsafeRete ) 
	{
		if( Pmac::PTools->GetUseTRDforToolChangeMacro() == TRUE ) 
		{
			nReplaceToolNo = nToolNo;
			while( TRUE ) 
			{
				nReplaceToolNo = Pmac::PTools->GetNextRelatedToolNo( nReplaceToolNo );
				if( nReplaceToolNo == 0 ) {
					break;
				}
				fTempToolUasgeRate = Pmac::PTools->GetToolData( nReplaceToolNo ).fUsageRate;
				if( fTempToolUasgeRate > fTempMaxUsafeRete ) {
					continue;
				} else {
					break;
				}
			}
		}
	}

	return nReplaceToolNo;
}
*/

int pa::CGCodeHelper::CheckM140_M145_Restart(int nToolNo )
{
	double fTempToolUsageRate = pa::PTool->GetToolData( nToolNo )->fUsingRate;
	double fTempMaxUsageRate  = 99.0;
	int nReplaceToolNo = nToolNo;

	if( pa::PTool->GetEnableToolUsageTime() )
	{
		// Tool 사용시간 기능이 Enable일 경우,
		if( fTempToolUsageRate > fTempMaxUsageRate ) 
		{
			// Tool의 사용율이 지났고, 
			if( pa::PTool->GetEnableToolUsageTime() )
			{
				// 연관툴 사용기능이 Enable 일 경우,
				// 사용할 수 있는 다음 툴을 찾는다 
				while( TRUE )
				{
//					nReplaceToolNo = pa::PTool->GetNextRelatedToolNo( nReplaceToolNo );
					nReplaceToolNo = 0;
					if( nReplaceToolNo == 0 ) 
					{
						break;
					}
					fTempToolUsageRate = pa::PTool->GetToolData( nReplaceToolNo )->fUsingRate;
					if( fTempToolUsageRate > 99.0 ) {
						continue;
					} 
					else 
					{
						break;
					}
				}
			}
		}
	}

	return nReplaceToolNo;
}

/** 
 * GCode에 명령 교환
 */
/*
void pmac::CGCodeHelper::CheckGCodeReplace( CString& strGCode )
{
	std::map<CString, CString>::iterator itr;

	for( itr = PConfig->mapReplaceCommand.begin(); itr != PConfig->mapReplaceCommand.end(); itr++ ) 
	{
		CString strKey	= itr->first;
		CString strValue= itr->second;
		if( strGCode.Replace( strKey.MakeLower(), strValue ) == 0 ) 
		{
			strGCode.Replace( strKey.MakeUpper(), strValue );
		}
	}
}
*/

void pa::CGCodeHelper::CheckReplaceCommand( char* pGCode )
{
	char	szBuffer[256];
	char*	pTempGCode = pGCode;
	char*	pTempBuffer= szBuffer;
	char*	p = NULL;

	memset((void*)szBuffer, 0, sizeof(char)*256);

	for( int i = 0; i<nNumReplaceCommand; i++ ) {
		p = strstr( pGCode, szSourceCommand[i] );
		if( p ) {
			// pGCode에서 p까지 복사 
			int len1 = p - pTempGCode;
			memcpy((void*)pTempBuffer, pGCode, sizeof(char)*len1);
			pTempGCode += len1 + strlen(szSourceCommand[i]);			// 대체하는 코드 다음 명령을 가르킨다 
			// Replace 문자열 복사 
			int len2 = strlen(szReplaceCommand[i]);
			memcpy((void*)(pTempBuffer+len1), szReplaceCommand[i], sizeof(char)*len2);
			pTempBuffer += len2 + len1;
			// 나머지 문자열 복사 
			memcpy((void*)(pTempBuffer), (const void*)(pTempGCode), sizeof(char)*strlen(pTempGCode));
			//
			memset( (void*)pGCode, 0, sizeof(char)*256 );
			memcpy( (void*)pGCode, (const void*)szBuffer, sizeof(char)*strlen(szBuffer) );
		}
	}
}

/** 
 * Nc File Check 함수
 * 라인 단위로 입력되기 때문에 코드 단위로 파싱 해야함 
 */
BOOL pa::CGCodeHelper::CheckNcFile( char* pNCCode )
{
	char sztemp[64];
	int tempIndex = 0;
	int len = strlen( pNCCode );

	// 검사할 명령의 개수가 0이면 리턴 한다 
	if( nNumCheckCommand == 0 ) {
		return TRUE;
	}

	//////////////////////////////////////////////////////////////////////////
	// 2016.07.27. profile 명령 예외 추가 
	if( strstr(pNCCode, "profile") || strstr(pNCCode, "PROFILE") )
	{
		return TRUE;
	}
	//////////////////////////////////////////////////////////////////////////

	memset( (void*)sztemp, 0, sizeof(char)*64 );
	tempIndex = 0;

	for( int i = 0; i<len; i++ )
	{
		char c = pNCCode[i];		
		if( c == ' ' ) continue;	// skip space 

		BOOL bIsValue = ( ( c >= '0' && c <= '9' ) || ( c == '.' ) || ( c == '-') || ( c == '+' ) );

		if( !bIsValue ) 
		{
			if( tempIndex > 0 )
			{
				// 데이터 확인 
				char	cCode = sztemp[0];
				double	fData = atof(sztemp+1);
				BOOL	bFind = FALSE;
				int		index_command = 0;

				if( cCode != '%' )
				{
// 					//////////////////////////////////////////////////////////////////////////
// 					// 2016.07.26 profile 명령 추가 
// 					if( strstr(sztemp, "profile") || strstr(sztemp, "PROFILE") ) 
// 					{
// 						// OK
// 					}
// 					//////////////////////////////////////////////////////////////////////////
// 					else 
// 					{
						for( index_command = 0; index_command<nNumCheckCommand; index_command++ )
						{
							if( cCode == szCheckCommands[index_command] ) {
								bFind = TRUE;
								break;
							}
						}
						if( bFind ) {
						//	if( fData > fCheckCommandData[index_command][0] && fData < fCheckCommandData[index_command][1] ) {
							if( (fData - fCheckCommandData[0][index_command]) > -0.1 &&
								(fCheckCommandData[1][index_command] - fData) > -0.1 ) {
								// OK
							} 
							else {
								// ERROR. 데이터 범위 넘어섬
								return FALSE;
							}
						}
						else {
							// ERROR. 알수 없는 명령어 
							return FALSE;
						}
// 					}
				}
			}
						
			// 초기화 
			tempIndex = 0;
			memset((void*)sztemp, 0, sizeof(char)*64);
			sztemp[tempIndex++] = c;
		}
		else 
		{
			sztemp[tempIndex++] = c;
		}
	}

	return TRUE;
}


