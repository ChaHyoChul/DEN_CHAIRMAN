	void DoStopAutoCalCoordinateOffset();
	void DoStartAutoTeachMultiOrigin();
	void DoStopAutoTeachMultiOrigin();
	void DoStartAutoTeachToolPocket();
	void DoStopAutoTeachToolPocket();

	void DoStartAutoCalSingleAbutmentCoordinateOffset();
	void DoStopAutoCalSingleAbutmentCoordinateOffset();
	void DoStartAutoCalSingleAbutmentCoordinateOffset_A();
	void DoStopAutoCalSingleAbutmentCoordinateOffset_A();

	void DoStartATCTest();
	void DoStopATCTest();

	BOOL OpenNCFile( int nNCFileIndex, CString& strErrMsg );
	void CloseNCFile();

