    LTEXT           "▶",IDC_STATIC_ARROW_23,210,45,8,11
    LTEXT           "▶",IDC_STATIC_ARROW_34,290,45,8,11
    LTEXT           "▶",IDC_STATIC_ARROW_45,370,45,8,11
    LTEXT           "▶",IDC_STATIC_ARROW_56,450,45,8,11
