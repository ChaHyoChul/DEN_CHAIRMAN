    CTEXT           "1 / 6",IDC_STATIC_CURRENT_STEP,263,370,54,32,SS_CENTERIMAGE,WS_EX_STATICEDGE
    PUSHBUTTON      "Next ▶",IDC_BUTTON_NEXT,319,369,71,34,NOT WS_TABSTOP
    PUSHBUTTON      "Back",IDC_BUTTON_CLOSE,505,370,71,34,NOT WS_TABSTOP
END

IDD_DIALOG_SETUP_AUTOCAL_STEP1 DIALOGEX 0, 0, 446, 167
STYLE DS_SETFONT | WS_CHILD | WS_BORDER
FONT 12, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    CONTROL         "1. Prepare calibration accessories",IDC_STATIC_IMG1_TITLE,
                    "Static",SS_LEFTNOWORDWRAP | WS_GROUP,76,7,132,11
    CONTROL         188,IDC_STATIC_IMG1,"Static",SS_BITMAP,71,47,303,120
    CONTROL         "(a) 3 mm hex key\r\n(b) Calibration tools for left and right spindles\r\n(c) Calibration cylinder\r\n(d) Calibration cable ",IDC_STATIC_IMG1_DESC,
                    "Static",SS_LEFTNOWORDWRAP | WS_GROUP,210,7,190,39
END

IDD_DIALOG_SETUP_AUTOCAL_STEP2 DIALOGEX 0, 0, 768, 321
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_BORDER
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "1. Insert one calibration tool in the left collet\r\n\r\n2. Insert the other calibration tool in the right collet",IDC_STATIC_IMG1_TITLE,143,14,355,81
    CONTROL         190,IDC_STATIC_IMG1,"Static",SS_BITMAP,157,156,154,154
    CONTROL         191,IDC_STATIC_IMG2,"Static",SS_BITMAP,320,156,114,154
    CONTROL         192,IDC_STATIC_IMG3,"Static",SS_BITMAP,444,157,177,154
    CONTROL         "LEFT Collet Open",IDC_CHECK_TOOL_CLAMP_UNCLAMP,"Button",BS_AUTOCHECKBOX | BS_PUSHLIKE | BS_MULTILINE | WS_TABSTOP,499,6,143,30
    CONTROL         "RIGHT Collet Open",IDC_CHECK_TOOL2_CLAMP_UNCLAMP,"Button",BS_AUTOCHECKBOX | BS_PUSHLIKE | BS_MULTILINE | WS_TABSTOP,499,45,142,31
    CONTROL         "(a) Open the collet using the ""LEFT/RIGHT Unclamp"" button\r\n(b) Insert the tool in the opened collet\r\n(c) While holding the tool in the collet, press the ""LEFT/RIGHT Clamp"" button to close the collet.",IDC_STATIC_IMG1_DESCR,
                    "Static",SS_LEFTNOWORDWRAP | WS_GROUP,177,98,497,56
END

IDD_DIALOG_SETUP_AUTOCAL_STEP3 DIALOGEX 0, 0, 585, 245
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_BORDER
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "1. Mount the calibration cylinder using 3 mm hex key.",IDC_STATIC_IMG1_TITLE,24,18,147,29
    CONTROL         209,IDC_STATIC_IMG1,"Static",SS_BITMAP | SS_REALSIZEIMAGE | SS_SUNKEN,38,65,114,144
    CONTROL         202,IDC_STATIC_IMG2,"Static",SS_BITMAP | SS_SUNKEN,191,39,361,187
    LTEXT           "2. Verify the tools and the cylinder are mounted as shown in the picture.",IDC_STATIC_IMG2_TITLE,195,16,354,18
    GROUPBOX        "",IDC_STATIC_G2,14,7,161,228
    GROUPBOX        "",IDC_STATIC_G3,175,7,394,228
END

IDD_DIALOG_SETUP_AUTOCAL_STEP4 DIALOGEX 0, 0, 512, 214
STYLE DS_SETFONT | WS_CHILD | WS_BORDER
FONT 9, "Tahoma", 400, 0, 0x0
BEGIN
    GROUPBOX        "",IDC_STATIC_G2,8,4,167,203
    LTEXT           "1. Connect the calibration cable to the socket on the side panel",IDC_STATIC_IMG1_TITLE,16,13,152,32
    CONTROL         189,IDC_STATIC_IMG1,"Static",SS_BITMAP,31,49,137,158
    GROUPBOX        "",IDC_STATIC_G3,174,4,166,203
    LTEXT           "2. Perform a conduction test with one magnet end",IDC_STATIC_IMG2_TITLE,183,14,152,32
    CONTROL         203,IDC_STATIC_IMG2,"Static",SS_BITMAP | SS_REALSIZEIMAGE | WS_DISABLED,210,53,112,130
    CHECKBOX        " Touch Signal On/Off",IDC_CHECK_TOUCH_SIGNAL,219,185,101,9
    GROUPBOX        "",IDC_STATIC_G4,340,4,168,203
    LTEXT           "3. Attach both magnet rings to the calibration tools",IDC_STATIC_IMG3_TITLE,349,14,152,32
    CONTROL         195,IDC_STATIC_IMG3,"Static",SS_BITMAP | SS_REALSIZEIMAGE,367,53,130,137
END

IDD_DIALOG_SETUP_AUTOCAL_STEP5 DIALOGEX 0, 0, 585, 255
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_BORDER
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL         " Touch Signal On/Off",IDC_CHECK_TOUCH_SIGNAL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,472,173,82,9
    PUSHBUTTON      "START",IDC_BUTTON_START_STOP,451,193,123,50
    GROUPBOX        "",IDC_STATIC_G2,452,80,123,86
    LTEXT           "Auto Calibration Progress:",IDC_STATIC_AT_SCOPE,457,88,110,11
    CONTROL         " X-axis center",IDC_CHECK_X_AXIS_CENTER,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,468,101,92,9
    CONTROL         " YL-axis center",IDC_CHECK_Y1AXIS_CENTER,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,468,113,92,9
    CONTROL         " YR-axis center",IDC_CHECK_Y2AXIS_CENTER,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,468,124,92,9
    CONTROL         " ZL-axis origin offset",IDC_CHECK_Z1AXIS_ORG_OFFSET,
                    "Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,468,136,92,9
    CONTROL         " ZR-axis origin offset",IDC_CHECK_Z2AXIS_ORG_OFFSET,
                    "Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,468,148,92,9
    CONTROL         199,IDC_STATIC_IMG1,"Static",SS_BITMAP | SS_REALSIZEIMAGE | SS_SUNKEN,0,0,439,255
    LTEXT           "1. Start the calibration",IDC_STATIC_IMG1_TITLE,450,10,125,12
    LTEXT           "If the milling room looks as shown in the picture, press the START button and wait until the finish message appears.",IDC_STATIC_IMG1_DESCR,451,26,123,51
END

IDD_DIALOG_SETUP_AUTOCAL_STEP6 DIALOGEX 0, 0, 585, 285
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_BORDER
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL         "1. Disconnect and remove the calibration cable.",IDC_STATIC_SUBSTEP1,
                    "Static",SS_LEFTNOWORDWRAP | WS_GROUP,51,30,293,20
    CTEXT           "Congratulations!",IDC_STATIC_SUCCESS_TXT2,133,183,314,68,SS_CENTERIMAGE
    CONTROL         "2. Remove the calibration tools from both collets and store them in the case.",IDC_STATIC_SUBSTEP2,
                    "Static",SS_LEFTNOWORDWRAP | WS_GROUP,51,58,483,20
    CONTROL         "3. Remove the calibration cylinder from the pin-type holder.",IDC_STATIC_SUBSTEP3,
                    "Static",SS_LEFTNOWORDWRAP | WS_GROUP,51,137,321,20
    CTEXT           "You have successfuly completed the Auto Calibration.",IDC_STATIC_SUCCESS_TXT1,183,251,213,17
    CONTROL         "LEFT Collet Open",IDC_CHECK_TOOL_CLAMP_UNCLAMP,"Button",BS_AUTOCHECKBOX | BS_PUSHLIKE | BS_MULTILINE | WS_TABSTOP,406,81,128,21
    CONTROL         "RIGHT Collet Open",IDC_CHECK_TOOL2_CLAMP_UNCLAMP,"Button",BS_AUTOCHECKBOX | BS_PUSHLIKE | BS_MULTILINE | WS_TABSTOP,406,102,128,22
    CONTROL         "(a) While holding the tool, open the collet using the ""LEFT/RIGHT Unclamp"" button.\r\n(b) Put out the tool from the opened collet.\r\n(c) Close the collet using the ""LEFT/RIGHT Clamp"" button.",IDC_STATIC_SUBSTEP2_DESC,
                    "Static",SS_LEFTNOWORDWRAP | WS_GROUP,72,80,328,43
    GROUPBOX        "",IDC_STATIC_G2,35,13,515,158
END


