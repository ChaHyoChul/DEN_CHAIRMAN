{
// 	BOOL b = TRUE;
// 
// 	for( int i = 0; i<pa::PSWConfig->GetConfigData()->nNumAxis; i++ )
// 	{
// 		if( fabs(pa::PPAStatus->GetPAStatus()->fVelocity[i]) > 0.2 )		// > 0.05
// 		{
// 			b = FALSE;
// 			break;
// 		}
// 	}
// 	if( b && pa::PAutoLoader->IsUsingAutoLoader() ) {
// 		// autolaoder 축의 모터 상태를 확인 한다 
// 	}
// 
// 	return b;

	BOOL bRet = (pa::PPAStatus->GetPAStatus()->nMotorMovingFlag == 0) ? TRUE : FALSE;

	return bRet;
}
 
int CEPncUIApp::ExitInstance()
{
	return CWinApp::ExitInstance();
}

//////////////////////////////////////////////////////////////////////////
// Keyboard를 이용한 jog 이동 기능을 이 곳에 구현한다  
//////////////////////////////////////////////////////////////////////////
/*
	left	: 37	X+
	right	: 39	X-
	up 		: 38	Y-
	down	: 40	Y+
	pageup 	: 33	Z-
	pagedown: 34	Z+

	<		: 188	A+
	>		: 190	A-
	P		: 79	B+
	L		: 76	B-

	+ 		: 187	JOG/SPD+
	- 		: 189	JOG/SPD-
*/

BOOL CEPncUIApp::PreTranslateMessage(MSG* pMsg)
{
	CString strTrace;
	BOOL	process = FALSE;

	/*
	if( hJogMode_ != KB_JOG_MODE_NONE ) 
	{
		if( hJogMode_ == KB_JOG_MODE_XYS ) 
		{
			//////////////////////////////////////////////////////////////////////////
			// XY-Stage의 Jog 기능. GetKeyState 함수를 사용해서 특수키 상태를 읽을 수 있다
			UINT virtualKeyCode = pMsg->wParam;
			BOOL pressShiftKey = (BOOL)(GetAsyncKeyState( VK_LSHIFT ) != 0);	// LSHIFT 키 상태 조회  
			BOOL bStep = pressShiftKey;

			if( pMsg->message == WM_KEYDOWN ) 
			{
				strTrace.Format( _T("KEY CODE: %d\n"), virtualKeyCode );

				switch( virtualKeyCode )
				{
				case 37:	// X+
					startJog( pmac::AXIS_X, bStep, TRUE  ); process = TRUE; break;
				case 39:	// X-
					startJog( pmac::AXIS_X, bStep, FALSE ); process = TRUE; break;
				case 38:	// Y+
					startJog( pmac::AXIS_Y, bStep, TRUE  ); process = TRUE; break;
				case 40:	// Y-
					startJog( pmac::AXIS_Y, bStep, FALSE ); process = TRUE; break;
				case 33:	// Z-
					startJog( pmac::AXIS_Z, bStep, TRUE  ); process = TRUE; break;
				case 34:	// Z+
					startJog( pmac::AXIS_Z, bStep, FALSE ); process = TRUE; break;
				case 188:	// A+
					startJog( pmac::AXIS_A, bStep, TRUE  ); process = TRUE; break;
				case 190:	// A-
					startJog( pmac::AXIS_A, bStep, FALSE ); process = TRUE; break;
				case 79:	// B+
					startJog( pmac::AXIS_B, bStep, TRUE  ); process = TRUE; break;
				case 76:	// B-
					startJog( pmac::AXIS_B, bStep, FALSE ); process = TRUE; break;

				case 187:	// Jog Spd+
					setMotorOverride( pmac::PState->GetPmacState()->nMotorOverride + 5 ); process = TRUE; break;
				case 189:	// Jog Spd-
					setMotorOverride( pmac::PState->GetPmacState()->nMotorOverride - 5 ); process = TRUE; break;
				}
				strTrace.Format(_T("VIRTUAL KEY : %d\n", virtualKeyCode ));
				TRACE( strTrace );
			}
			else if( pMsg->message == WM_KEYUP ) 
			{
				switch( virtualKeyCode )
				{
				case 37:	// X+
				case 39:	// X-
					stopJog( pmac::AXIS_X ); process = TRUE; break;
				case 38:	// Y-
				case 40:	// Y+
					stopJog( pmac::AXIS_Y ); process = TRUE; break;
				case 33:	// Z-
				case 34:	// Z+
					stopJog( pmac::AXIS_Z ); process = TRUE; break;
				case 188:	// A+
				case 190:	// A-
					stopJog( pmac::AXIS_A ); process = TRUE; break;
				case 79:	// B+
				case 76:	// B-
					stopJog( pmac::AXIS_B ); process = TRUE; break;
				}
			}
			//////////////////////////////////////////////////////////////////////////
		}
		else if( hJogMode_ == KB_JOG_MODE_AL )
		{
			UINT virtualKeyCode = pMsg->wParam;
			BOOL pressShiftKey = (BOOL)(GetAsyncKeyState( VK_LSHIFT ) != 0);	// LSHIFT 키 상태 조회  
			BOOL bStep = pressShiftKey;
			//////////////////////////////////////////////////////////////////////////
			// AutoLoader의 Jog 기능 
			if( pMsg->message == WM_KEYDOWN ) 
			{
				switch( virtualKeyCode )
				{
				case 33:	// Z-
					startJog( (pmac::EN_AXIS)5, bStep, TRUE  ); process = TRUE; break;
				case 34:	// Z+
					startJog( (pmac::EN_AXIS)5, bStep, FALSE ); process = TRUE; break;

				case 187:	// Jog Spd+
					setMotorOverride( pmac::PState->GetPmacState()->nMotorOverride + 5 ); process = TRUE; break;
				case 189:	// Jog Spd-
					setMotorOverride( pmac::PState->GetPmacState()->nMotorOverride - 5 ); process = TRUE; break;
				}
			}
			else if( pMsg->message == WM_KEYUP ) 
			{
				switch( virtualKeyCode )
				{
				case 33:	// Z-
				case 34:	// Z-
					stopJog( (pmac::EN_AXIS)5 ); process = TRUE; break;
				}
			}
			//////////////////////////////////////////////////////////////////////////
		}
	}
	*/

	if( hKeyboardMgeReceiveWnd_ != NULL && ( pMsg->message == WM_KEYDOWN || pMsg->message == WM_KEYUP ) )
	{
		LRESULT lr = ::SendMessage( hKeyboardMgeReceiveWnd_, WM_HCCHA_KEY_MSG, (WPARAM)pMsg, (LPARAM)0 );

		process = (lr == 0) ? FALSE : TRUE;
	}

//	return CWinApp::PreTranslateMessage(pMsg);
	BOOL bRet = TRUE;
	if( !process ) {
		bRet = CWinApp::PreTranslateMessage(pMsg);
	}
	return bRet;
}

void CEPncUIApp::MsgPump()
{
	MSG msg;

	if( PeekMessage( &msg, NULL, 0, 0, PM_REMOVE ) ) 
	{
		if( msg.message == WM_QUIT )
		{
			PostQuitMessage( 0 );
			return ;
		}
		TranslateMessage( &msg );
		DispatchMessage( &msg );
	}
}

void CEPncUIApp::LoadPW()
{
	CCEIniFile	hIniFile;
	CString		strTemp;

	hIniFile.Open( INI_PW_PATH );

	hIniFile.GetValue( _T("PW"), _T("MGR"), &strTemp );
	pa::STR_USER_MODE_PW[pa::USER_MODE_MGR] = strTemp;

	hIniFile.Close();
}

void CEPncUIApp::SavePW( pa::EN_USER_MODE hUserMode, CString strPW )
{
	CCEIniFile	hIniFile;
	CString		strTemp;

	hIniFile.Open( INI_PW_PATH );

	switch( hUserMode )
	{
	case pa::USER_MODE_USR:
		break;
	case pa::USER_MODE_MGR:
		hIniFile.SetValue( _T("PW"), _T("MGR"), strPW );
		break;
	case pa::USER_MODE_RND:
		break;
	}

	hIniFile.Close();
}

BOOL CEPncUIApp::isRunningProgram( void )
{
	BOOL	bRtValue= FALSE;
	HANDLE	hMutex	= ::OpenMutex( MUTEX_ALL_ACCESS, FALSE, _T("Robots and Design : EPncUI") );

	if( hMutex != NULL ) { bRtValue = TRUE; }
	else 
	{
		int		nCount = 0;
		while( hMutex == NULL && nCount < 5 )
		{
			hMutex = ::CreateMutex( NULL, FALSE, _T("Robots and Design : EPncUI") );
			nCount++;
		}
		if( hMutex == NULL ) bRtValue = TRUE;
	}

	return bRtValue;
}
