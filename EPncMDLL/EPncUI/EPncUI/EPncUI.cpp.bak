	// 반환합니다.
	return FALSE;
}

BOOL CEPncUIApp::MotionDone( BOOL checkingMotorStop )
{
	BOOL b = (BOOL)( pa::PPAStatus->GetPAStatus()->nRunStatus == pa::PA_RUN_STATUS_IDLE );

	if( checkingMotorStop )
	{
		b &= IsMotorStop();
	}

	return b;
}

