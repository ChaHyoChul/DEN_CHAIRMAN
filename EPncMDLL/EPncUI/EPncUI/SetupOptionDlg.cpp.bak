	}
	//////////////////////////////////////////////////////////////////////////
//	if( PREV_STATE != curr_state ) 
	else
	{
		PREV_STATE = curr_state;

#ifdef _PA_G2400_
		chkUsingBlockAutoLoader_.EnableWindow( curr_state );
		chkUsingOpPanel_.EnableWindow( curr_state );
		chkUsingDetectBlockSensor_.EnableWindow( curr_state );
