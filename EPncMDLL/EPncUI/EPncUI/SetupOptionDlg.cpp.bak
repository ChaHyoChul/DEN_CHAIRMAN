void CSetupOptionDlg::OnBnClickedCheckInvalidNcCode()
{
	BOOL b = chkInvalidNcCode_.GetCheck();

	if( b ) {
		chkInvalidNcCode_.SetCheck( TRUE );
	} else {
		chkInvalidNcCode_.SetCheck( FALSE );
	}

	UpdateData( FALSE );
}

